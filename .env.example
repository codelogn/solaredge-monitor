SOLAREDGE_USERNAME=CHANGEME
SOLAREDGE_PASSWORD=CHANGEME
SOLAREDGE_SITE_ID=

# Seconds between polling cycles. One HTTP request per cycle covers every
# optimizer, so this is also the request rate: 120s = ~720 requests/day.
# The optimizers themselves only produce a new measurement every ~4.5 min
# (measured), so polling much faster than 120s collects duplicates rather
# than extra data. Raise this if the dashboard starts reporting rate limits.
POLL_INTERVAL_SECONDS=120

# How often to re-run optimizer discovery (site layout call) in the background.
DISCOVERY_REFRESH_HOURS=24

DB_PATH=data/solar_monitor.db
COOKIES_PATH=session/cookies.json

# IANA timezone for hour-of-day analysis (e.g. Europe/London, America/New_York).
# Readings are stored in UTC; this only affects hour labels and the hour filter.
# Leave blank to use this machine's timezone.
SITE_TIMEZONE=

# Inverter Modbus TCP endpoint — AC voltage/power/status, which the cloud
# API does not expose at all. Blank disables the read.
INVERTER_MODBUS_HOST=
INVERTER_MODBUS_PORT=1502
# Seconds between Modbus reads. Local-only (no cloud requests), so it can
# run far faster than POLL_INTERVAL_SECONDS to catch short midday peaks.
MODBUS_INTERVAL_SECONDS=30

# Optional: total panel rating in watts (e.g. 20 panels x 365 W = 7300).
# Shown next to today's peak on the dashboard. Leave blank to hide.
ARRAY_NAMEPLATE_W=

# Comma-separated serials of optimizers physically removed or replaced.
# They stay in SolarEdge's layout forever; excluding them keeps known-dead
# hardware from sitting at the bottom of every report and hiding real faults.
DECOMMISSIONED_SERIALS=
